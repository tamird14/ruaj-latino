{
  "buildCommand": "npx prisma generate --schema=apps/api/src/prisma/schema.prisma && npm run build:web",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "installCommand": "npm install --include=dev",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ]
}
